# =============================================================================
# 2ZTech Downloader - Environment Configuration
# Copy to .env and adjust values for your environment
# =============================================================================

# Application
APP_NAME=2ZTech Downloader
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ztech
POSTGRES_PASSWORD=ztech_secure_password_change_me
POSTGRES_DB=ztech_downloader
DATABASE_URL=postgresql+asyncpg://ztech:ztech_secure_password_change_me@postgres:5432/ztech_downloader

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# JWT / Auth
JWT_SECRET_KEY=change-me-jwt-secret-key-very-long-and-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Workers & Downloads
MAX_WORKERS=5
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=300
DOWNLOAD_TIMEOUT_SECONDS=3600
MAX_CONCURRENT_DOWNLOADS_PER_USER=10
DEFAULT_DOWNLOAD_PATH=/app/downloads
MAX_FILE_SIZE_MB=10240

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/downloads

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Security
SSRF_BLOCK_PRIVATE_IPS=true
ALLOWED_URL_SCHEMES=http,https
